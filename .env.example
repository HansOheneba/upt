# Copy to .env.local and fill in real values for your environment.
# Never commit real values; .env* is gitignored.

# ── White-label tenant selection ────────────────────────────────────────────
# Selects which brand config (config/brands.ts) this deployment renders.
# Valid values: upt | celerey | ecobank | stanbic | absa | gcb | fidelity | access | omnibsic | fnb | petra
# This repo defaults to upt (United Pension Trustees).
# (stanbic = Stanbic Investment Management Services; fnb = FNB Ghana / FirstRand)
# Each brand gets its own Vercel project/deployment with its own env vars.
# See docs/architecture/WHITE_LABELING.md.
NEXT_PUBLIC_TENANT=upt

# ── App / API ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_API_URL=
NEXT_PUBLIC_APP_URL=

# ── Stripe / billing ─────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_CORE_SUBSCRIPTION_URL_7DAYS_TRIAL=
NEXT_PUBLIC_CORE_SUBSCRIPTION_URL_PREMIUM=
NEXT_PUBLIC_CORE_SUBSCRIPTION_PRICE_ID=

# ── Misc ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEMO_USER=
NEXT_PUBLIC_GOOGLE_API_KEY=

# ── Market prices (server-side secret) ──────────────────────────────────────
# Quote route uses FINNHUB_API_KEY. FINNHUB_WEBHOOK_SECRET is for inbound
# Finnhub trade webhooks and is not sent with quote requests.
FINNHUB_API_KEY=
FINNHUB_WEBHOOK_SECRET=

# ── AI assistant (server-side secret) ───────────────────────────────────────
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
DEMO_AI_ENABLED=
